{
  "name": "formtura",
  "version": "1.0.6",
  "description": "A modern, intuitive, and powerful form builder for WordPress",
  "main": "assets/js/builder.js",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "dev:server": "vite --mode development",
    "build": "vite build --mode production",
    "watch": "vite build --watch --mode development",
    "preview": "vite preview",
    "lint": "eslint builder assets/js jest.config.js jest.setup.js tests/js --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint builder assets/js jest.config.js jest.setup.js tests/js --ext .js,.jsx,.ts,.tsx --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "bash scripts/e2e-run.sh",
    "release": "bash scripts/build-release.sh",
    "release:verify": "bash scripts/verify-release.sh"
  },
  "keywords": [
    "wordpress",
    "form",
    "form-builder",
    "drag-and-drop"
  ],
  "author": "Formtura Team",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.4",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jquery": "^3.7.1",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^0.294.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
